{
  "opencollection": "1.0.0",
  "info": {
    "name": "BigChange DX REST Assets Reference Data API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reference Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of job types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bigchange.com/v1/jobTypes",
            "headers": [
              {
                "name": "Customer-Id",
                "value": ""
              }
            ]
          },
          "docs": "Get a list of job types"
        }
      ]
    }
  ],
  "bundled": true
}