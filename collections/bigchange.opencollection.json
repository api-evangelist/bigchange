              {
                "name": "Customer-Id",
                "value": "{{customerId}}"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new job."
        },
        {
          "info": {
            "name": "Get a job",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bigchange.com/v1/jobs/:jobId",
            "params": [
              {
                "name": "jobId",
                "value": "",
