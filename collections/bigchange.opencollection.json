            "name": "Get a list of jobs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bigchange.com/v1/jobs",
            "headers": [
              {
                "name": "Customer-Id",
                "value": "{{customerId}}"
              }
            ]
          },
          "docs": "Returns a paged list of jobs. Filter by type, contact, resource, order number, and created-at range."
        },
        {
          "info": {
            "name": "Create a job",
            "type": "http"
          },
          "http": {
            "method": "POST",
